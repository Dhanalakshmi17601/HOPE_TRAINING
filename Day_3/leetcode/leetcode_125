class Solution {
    public boolean isPalindrome(String s) {
        s=s.toLowerCase();
        s=s.replaceAll("[^a-z0-9]","");
        int start=0,last=s.length()-1;
        while(start<last)
        {
            if(s.charAt(start)!=s.charAt(last))
            {
                return false;
            }
            start++;
            last--;

        }
        return true;
        
    }
}
