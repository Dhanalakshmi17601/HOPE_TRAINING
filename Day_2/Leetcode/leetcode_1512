class Solution {
    public int numIdenticalPairs(int[] nums) {
        int gp=0;
        for(int i=0;i<nums.length-1;i++)
        {
            for(int j=nums.length-1;j>0;j--)
            {
                if(nums[i]==nums[j]&&i<j)
                {
                    gp=gp+1;
                }
            }
        }
        return gp;
        
    }
}