class Solution {
    public int numJewelsInStones(String jewels, String stones) {
        int count=0;
        Set<Character> set1=new HashSet<>();
        for(Character ch:jewels.toCharArray())
        {
            set1.add(ch);
        }
        for(Character ch:stones.toCharArray())
        {
            if(set1.contains(ch))
            {
                count++;
            }
        }
        return count;
        
    }
}